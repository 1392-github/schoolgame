--- !u!114 &570245165
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 570245161}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1e20f123de34ad741ab8bdf12b462ec8, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  text: "\uC218\uC2DC \uBAA8\uC9D1\uC5D0\uC11C \uCD5C\uC885 \uD569\uACA9\uD558\uAE30
    \uC704\uD574 \uD544\uC694\uD55C \uCD5C\uC18C\uD55C\uC758 \uC218\uB2A5 \uB4F1\uAE09\uC785\uB2C8\uB2E4.\n\"a\uAC1C
    \uC601\uC5ED \uD569 b\"\uB85C \uD45C\uAE30\uD558\uBA70,\n\uC218\uB2A5 \uC131\uC801
    \uC911 \uAC00\uC7A5 \uC88B\uC740 \uACFC\uBAA9 a\uAC1C\uC758 \uB4F1\uAE09\uC744
    \uD569\uD588\uC744 \uB54C b\uB97C \uB118\uC73C\uBA74 \uC548 \uB429\uB2C8\uB2E4.
    (b\uC5EC\uB3C4 \uD1B5\uACFC\uC785\uB2C8\uB2E4.)\n\n\uC608\uB97C \uB4E4\uC5B4
    \uC218\uB2A5 \uC131\uC801\uC774 59193\uC774\uACE0 \"2\uAC1C \uC601\uC5ED \uD569
    10\"\uC774\uBA74 59<color=red>1</color>9<color=red>3</color> \u2192 1+3 = 4 \u2264
    10 \u2192 \uD1B5\uACFC\uC785\uB2C8\uB2E4.\n\uBC18\uB300\uB85C, 35216\uC774\uACE0
    \"3\uAC1C \uC601\uC5ED \uD569 5\"\uBA74 <color=red>3</color>5<color=red>21</color>6
    \u2192 3+2+1 = 6 > 5 \u2192 \uD0C8\uB77D\uC785\uB2C8\uB2E4."
