--- !u!114 &1964775356
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1964775354}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\uC218\uC2DC\uBAA8\uC9D1\uC5D0\uC11C <b><u>3\uAC1C \uC804\uD615</u></b>\uC744
    \uCD08\uACFC\uD558\uC5EC \uC9C0\uC6D0\uD55C \uACBD\uC6B0 \uC9C0\uC6D0\uC790\uACA9\uC744
    \uBD80\uC5EC\uD558\uC9C0 \uC54A\uC73C\uBBC0\uB85C \uC218\uD5D8\uC0DD\uB4E4\uC740
    \uC774\uB97C \uC720\uC758\uD558\uC5EC \uC9C0\uC6D0\uD558\uC5EC\uC57C \uD568\r\n(\uD0C0
    \uB300\uD559\uC5D0 \uC9C0\uC6D0\uD55C \uD69F\uC218\uB97C \uBAA8\uB450 \uD3EC\uD568\uD568)\n\uC9C0\uC6D0\uC790\uAC00
    3\uAC1C \uC804\uD615\uC744 \uCD08\uACFC\uD558\uC5EC \uC9C0\uC6D0\uD560 \uACBD\uC6B0,
    \uCD08\uACFC\uC811\uC218\uD55C \uBAA8\uB4E0 \uC804\uD615\uC740 \uC811\uC218\uCDE8\uC18C
    \uCC98\uB9AC\uB428\n\n\uC218\uC2DC\uBAA8\uC9D1(\uD569\uACA9\uC790 \uBC0F \uCDA9\uC6D0
    \uD569\uACA9\uC790 \uD3EC\uD568)\uC5D0 \uC9C0\uC6D0\uD55C \uC790\uB294 <b><u>\uD569\uACA9
    \uBC0F \uB4F1\uB85D \uC5EC\uBD80\uC640 \uAD00\uACC4\uC5C6\uC774</u></b> \uC815\uC2DC\uBAA8\uC9D1\uC5D0
    \uC9C0\uC6D0\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4. \uC774\uB97C \uC704\uBC18\uD560
    \uACBD\uC6B0 \uBAA8\uB4E0 \uB300\uD559\uC758 \uC785\uD559\uC774 \uCDE8\uC18C\uB429\uB2C8\uB2E4.\n\n\uC815\uC2DC\uBAA8\uC9D1\uC5D0\uC11C\uB294
    \uBAA8\uC9D1\uAD70(\uAC00\uAD70, \uB098\uAD70, \uB2E4\uAD70)\uC774 \uAC19\uC740
    \uB300\uD559(\uBD84\uAD50 \uD3EC\uD568) \uAC04\uC5D0 \uBCF5\uC218\uC9C0\uC6D0\uC744
    \uD560 \uC218 \uC5C6\uC73C\uBA70, \uAC01 \uAD70\uBCC4\uB85C 1\uAC1C\uC758 \uB300\uD559\uC5D0\uB9CC
    \uC9C0\uC6D0\uD574\uC57C \uD569\uB2C8\uB2E4.\n\n\uC785\uD559\uD560 \uD559\uAE30\uAC00
    \uAC19\uC740 2\uAC1C \uC774\uC0C1\uC758 \uB300\uD559(\uC0B0\uC5C5\uB300\uD559,
    \uAD50\uC721\uB300\uD559, \uC804\uBB38\uB300\uD559 \uD3EC\uD568)\uC5D0 \uC774\uC911\uC73C\uB85C
    \uB4F1\uB85D\uD560 \uC218 \uC5C6\uC73C\uBA70, \uC774\uC911\uB4F1\uB85D \uC2DC
    \uBAA8\uB4E0 \uB300\uD559\uC758 \uD569\uACA9 \uBC0F \uC785\uD559\uC774 \uCDE8\uC18C\uB429\uB2C8\uB2E4.\n\n\uC778\uD130\uB137
    \uC6D0\uC11C\uC811\uC218\uB294 \uC804\uD615\uB8CC \uACB0\uC81C\uAC00 \uC644\uB8CC\uB41C
    \uD6C4 \uC811\uC218\uAC00 \uC644\uB8CC\uB418\uBA70, \uC811\uC218\uAC00 \uC644\uB8CC\uB41C
    \uD6C4\uC5D0\uB294 \uC9C0\uC6D0 \uB0B4\uC6A9 \uCDE8\uC18C \uBC0F \uBCC0\uACBD(\uBAA8\uC9D1\uB2E8\uC704
    \uB4F1)\uC774 \uC808\uB300 \uBD88\uAC00\uB2A5\uD558\uBBC0\uB85C \uC2E0\uC911\uD788
    \uC791\uC131\uD558\uC2DC\uAE30 \uBC14\uB78D\uB2C8\uB2E4.\n\n\uBCF8\uAD50\uB294
    \uB300\uD559 \uC785\uD559 \uC804\uD615 \uC5C5\uBB34\uB97C \uC704\uD574 \uC9C0\uC6D0\uC790\uC758
    \uAC1C\uC778\uC815\uBCF4 \uBC0F \uD559\uAD50\uC0DD\uD65C\uAE30\uB85D\uBD80 \uC804\uC0B0
    \uC790\uB8CC \uB4F1\uC744 \uC218\uC9D1\xB7\uD65C\uC6A9\uD558\uBA70, \uC6D0\uC11C
    \uC81C\uCD9C \uC2DC \uC774\uC5D0 \uB3D9\uC758\uD55C \uAC83\uC73C\uB85C \uAC04\uC8FC\uD569\uB2C8\uB2E4.\n\n\uC11C\uB958\uC758
    \uC704\xB7\uBCC0\uC870, \uB300\uB9AC \uC2DC\uD5D8, \uD5C8\uC704 \uC0AC\uC2E4
    \uAE30\uC7AC, \uAE30\uD0C0 \uBD80\uC815\uD55C \uBC29\uBC95\uC73C\uB85C \uD569\uACA9\uD558\uAC70\uB098
    \uC785\uD559\uD55C \uC0AC\uC2E4\uC774 \uD655\uC778\uB420 \uACBD\uC6B0 \uD569\uACA9
    \uBC0F \uC785\uD559\uC744 \uCDE8\uC18C\uD558\uBA70, \uD5A5\uD6C4 \uBCF8\uAD50
    \uC785\uD559 \uC9C0\uC6D0\uC5D0 \uC81C\uD55C\uC744 \uBC1B\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 1ef641c681c3bf84ca02a993905b88bb, type: 2}
