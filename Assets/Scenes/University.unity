--- !u!114 &1036327695
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1036327693}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1e20f123de34ad741ab8bdf12b462ec8, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  text: "\uD569\uACA9\uD655\uB960\uC740 \uC544\uB798\uC640 \uAC19\uC774 6\uB2E8\uACC4\uB85C
    \uAD6C\uBD84\uB418\uBA70 \uC0C9\uC0C1\uC740 \uC544\uB798\uC640 \uAC19\uC2B5\uB2C8\uB2E4.\n<color=#808080>0%:
    \uBD88\uAC00\uB2A5 (\uC2E4\uC81C\uB85C\uB294 \uAC80\uC815\uC0C9\uC73C\uB85C \uD45C\uC2DC\uB429\uB2C8\uB2E4.)</color>\n<color=#ff0000>1~19%:
    \uC704\uD5D8</color>\n<color=#ff8000>20~39%: \uC0C1\uD5A5</color>\n<color=#ffff00>40~59%:
    \uC18C\uC2E0</color>\n<color=#80ff00>60~79%: \uC801\uC815</color>\n<color=#00ff00>80~100%:
    \uD558\uD5A5</color>\n\n[\uACBD\uACE0] \uC218\uC2DC\uBAA8\uC9D1\uC5D0\uC11C \uC218\uB2A5\uCD5C\uC800\uD559\uB825\uAE30\uC900\uC5D0
    \uBBF8\uB2EC\uD55C \uACBD\uC6B0 \uD655\uB960\uACFC \uBB34\uAD00\uD558\uAC8C \uBD88\uD569\uACA9\uC774
    \uB418\uBA70,\n\uD655\uB960\uC774 100%\uC5EC\uB3C4 \uBD88\uD569\uACA9\uD560 \uC218
    \uC788\uC2B5\uB2C8\uB2E4."
