%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 608374822f1791f428418f4bab4f61f2, type: 3}
  m_Name: 2
  m_EditorClassIdentifier: 
  content:
  - "\uD018\uC2A4\uD2B8\uB97C \uD1B5\uD558\uC5EC XP\uB97C \uC5BB\uC744 \uC218 \uC788\uACE0,
    \uC774\uB97C \uD1B5\uD574 \uAC15\uD654\uB97C \uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\n\uD018\uC2A4\uD2B8
    \uCC3D\uC740 \uC9D1 \uBC16\uC5D0\uC11C PC\uC5D0\uC11C\uB294 Q \uD0A4\uB85C, \uBAA8\uBC14\uC77C\uC5D0\uC11C\uB294
    \uC624\uB978\uCABD \uC544\uB798\uC758 \uB3CB\uBCF4\uAE30(\uF002)\uB85C \uC5F4
    \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - "\uD018\uC2A4\uD2B8 \uCC3D\uC758 \uC624\uB978\uCABD \uC704\uC5D0 \uC788\uB294
    + \uBC84\uD2BC\uC744 \uD1B5\uD558\uC5EC \uD018\uC2A4\uD2B8\uB97C \uBC1B\uC744
    \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\n\uD018\uC2A4\uD2B8\uB294 1~5\uB808\uBCA8
    \uC911 \uD558\uB098\uB97C \uC120\uD0DD\uD558\uC5EC \uBC1B\uC744 \uC218 \uC788\uACE0,
    5\uB808\uBCA8\uB85C \uAC08\uC218\uB85D \uD018\uC2A4\uD2B8\uC758 \uB09C\uC774\uB3C4\uAC00
    \uC5B4\uB824\uC6CC\uC9C0\uACE0 \uBCF4\uC0C1\uC774 \uC99D\uAC00\uD569\uB2C8\uB2E4.\n\n\uD018\uC2A4\uD2B8\uB294
    \uAE30\uBCF8\uC801\uC73C\uB85C 1\uAC1C\uB9CC \uBC1B\uC744 \uC218 \uC788\uC73C\uBA70,
    \uD6C4\uC220\uD560 \"\uD018\uC2A4\uD2B8 \uCD5C\uB300 \uAC1C\uC218\" \uAC15\uD654\uB97C
    \uD1B5\uD574 \uAC1C\uC218\uB97C \uB298\uB9B4 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\n\uBC1B\uC744
    \uC218 \uC788\uB294 \uD018\uC2A4\uD2B8 \uBAA9\uB85D\uC740 \uD018\uC2A4\uD2B8\uB97C
    \uC218\uB77D\uD558\uAC70\uB098 \uC0C8\uB85C\uACE0\uCE68\uD560 \uB54C \uC0C8\uB85C
    \uBC14\uB00C\uBA70, \uC218\uB77D/\uC0C8\uB85C\uACE0\uCE68\uC744 \uD558\uC9C0
    \uC54A\uC740 \uACBD\uC6B0 \uADF8\uB300\uB85C \uC720\uC9C0\uB429\uB2C8\uB2E4.\n\n\uC0C8\uB85C\uACE0\uCE68\uC740
    \uD018\uC2A4\uD2B8\uB97C \uBC1B\uC9C0 \uC54A\uACE0 \uBAA9\uB85D\uC744 \uB2E4\uC2DC
    \uBF51\uB294 \uAE30\uB2A5\uC73C\uB85C, 300,000\uC6D0\uC774 \uC18C\uBAA8\uB429\uB2C8\uB2E4."
  - "\uD018\uC2A4\uD2B8\uB97C \uC644\uB8CC\uD558\uB824\uBA74 \uD45C\uC2DC\uB41C \uACFC\uBAA9\uC758
    \uB2A5\uB825\uCE58\uB97C \uC9C0\uC815\uB41C \uAC12 \uC774\uC0C1\uC73C\uB85C \uC62C\uB824\uC57C
    \uD569\uB2C8\uB2E4. \uD574\uB2F9 \uB2A5\uB825\uCE58\uB294 \uD018\uC2A4\uD2B8
    \uCC3D\uC5D0 \uD45C\uC2DC\uB429\uB2C8\uB2E4. \uC774\uB54C \uCDA9\uC871\uD55C
    \uB2A5\uB825\uCE58\uB294 \uCD08\uB85D\uC0C9, \uCDA9\uC871\uD558\uC9C0 \uC54A\uC740
    \uB2A5\uB825\uCE58\uB294 \uBE68\uAC04\uC0C9\uC73C\uB85C \uD45C\uC2DC\uB429\uB2C8\uB2E4.\n\n\uD018\uC2A4\uD2B8\uB97C
    \uC644\uB8CC\uD558\uBA74 \uD45C\uC2DC\uB41C XP\uAC00 \uC9C0\uAE09\uB418\uACE0,
    \uC2E4\uD328\uD558\uBA74(=\uAE30\uAC04 \uC774\uB0B4\uC5D0 \uC644\uB8CC\uD558\uC9C0
    \uC54A\uC73C\uBA74) XP\uAC00 \uCC28\uAC10\uB429\uB2C8\uB2E4.\n\n\uAE30\uBCF8\uC801\uC73C\uB85C
    \uD018\uC2A4\uD2B8\uB294 \uBC1B\uC740 \uC2DC\uC810\uC73C\uB85C\uBD80\uD130 1\uC77C
    \uC774\uB0B4\uC5D0 \uC644\uB8CC\uD574\uC57C \uD558\uBA70, \uD6C4\uC220\uD560
    \"\uD018\uC2A4\uD2B8 \uAE30\uAC04\" \uAC15\uD654\uB97C \uD1B5\uD574 \uAE30\uAC04\uC744
    \uB298\uB9B4 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uAC8C\uC784\uC774 \uC9C4\uD589\uB420\uC218\uB85D
    \uC804\uCCB4\uC801\uC778 \uD018\uC2A4\uD2B8\uC758 \uB09C\uC774\uB3C4\uAC00 \uC0C1\uC2B9\uD558\uC5EC
    1\uC77C \uC774\uB0B4\uC5D0 \uD018\uC2A4\uD2B8\uB97C \uC644\uB8CC\uD558\uAE30\uAC00
    \uBD88\uAC00\uB2A5\uD574\uC9C0\uBBC0\uB85C, \uD018\uC2A4\uD2B8 \uAE30\uAC04 \uAC15\uD654\uB97C
    \uC5B4\uB290 \uC815\uB3C4 \uD574 \uB450\uB294 \uAC83\uC744 \uAD8C\uC7A5\uD569\uB2C8\uB2E4."
  - "\uD018\uC2A4\uD2B8 \uAE30\uAC04\uC740 \uAE30\uAC04\uC774 \uB05D\uB098\uB294
    \uB0A0\uC9DC\uC758 \"\uC624\uC804 8\uC2DC\"\uC5D0 \uB05D\uB0A9\uB2C8\uB2E4.\n\n\uD018\uC2A4\uD2B8\uC758
    \uBCF4\uC0C1\uC740 \uB0A8\uC740 \uD018\uC2A4\uD2B8 \uAE30\uAC04\uACFC \uBB34\uAD00\uD558\uAC8C
    \uC870\uAC74\uC744 \uB2EC\uC131\uD55C \uC2DC\uC810\uC5D0 \uC989\uC2DC \uC9C0\uAE09\uB429\uB2C8\uB2E4."
  - "\uAC15\uD654\uB294 \uACF5\uBD80 \uD6A8\uC728, \uC218\uC785, \uD018\uC2A4\uD2B8
    \uCD5C\uB300 \uAC1C\uC218, \uD018\uC2A4\uD2B8 \uAE30\uAC04 4\uC885\uB958\uAC00
    \uC788\uC2B5\uB2C8\uB2E4.\n\n(\uC5EC\uAE30\uC5D0\uC11C \"\uBA87 % \uC99D\uAC00\"\uB294
    \uBAA8\uB450 \uBCF5\uB9AC\uB85C \uACC4\uC0B0\uB429\uB2C8\uB2E4. \uC608: 50% \uC99D\uAC00
    \uC2DC 1 \u2192 1.5 \u2192 2 \u2192 2.5 (X), 1 \u2192 1.5 \u2192 2.25 \u2192
    3.375 (O))\n\n\uAC15\uD654 \uB808\uBCA8\uC740 1\uB808\uBCA8\uC5D0\uC11C \uC2DC\uC791\uD569\uB2C8\uB2E4.\n\n\uACF5\uBD80
    \uD6A8\uC728\uC740 \uB2A5\uB825\uCE58\uAC00 \uC99D\uAC00\uD560 \uB54C \uC99D\uAC00\uB7C9\uC5D0
    \uACF1\uD574\uC9C0\uB294 \uAC12\uC73C\uB85C, \uC608\uB97C \uB4E4\uC5B4 \uACF5\uBD80
    \uD6A8\uC728\uC774 1.5\uC77C \uACBD\uC6B0 10\uB2E8\uACC4 \uBB38\uC81C\uC9D1\uC73C\uB85C
    \uC99D\uAC00\uD558\uB294 \uB2A5\uB825\uCE58\uC758 \uC591\uC774 15~30\uC774 \uB429\uB2C8\uB2E4.
    (1\uC77C \uB54C\uB294 10~20) \uAE30\uBCF8\uC801\uC73C\uB85C 1\uC5D0\uC11C \uC2DC\uC791\uD558\uC5EC
    1\uB808\uBCA8 \uC62C\uB9B4 \uB54C\uB9C8\uB2E4 3%\uC529 \uC99D\uAC00\uD569\uB2C8\uB2E4."
  - "\uC218\uC785\uC740 \uC791\uC5C5\uC18C\uC5D0\uC11C 1\uC2DC\uAC04\uC5D0 \uBC8C\uC5B4\uC9C0\uB294
    \uB3C8\uC758 \uC591\uC73C\uB85C, \uAE30\uBCF8\uC801\uC73C\uB85C 10000\uC6D0/1\uC2DC\uAC04\uC5D0\uC11C
    \uC2DC\uC791\uD558\uC5EC 1\uB808\uBCA8 \uC62C\uB9B4 \uB54C\uB9C8\uB2E4 2.5%\uC529
    \uC99D\uAC00\uD569\uB2C8\uB2E4.\n\n\uD018\uC2A4\uD2B8 \uCD5C\uB300 \uAC1C\uC218\uB294
    \uB3D9\uC2DC\uC5D0 \uD018\uC2A4\uD2B8\uB97C \uBC1B\uC744 \uC218 \uC788\uB294
    \uCD5C\uB300 \uAC1C\uC218\uB85C, \uAE30\uBCF8\uC801\uC73C\uB85C 1\uAC1C\uC5D0\uC11C
    \uC2DC\uC791\uD558\uC5EC 1\uB808\uBCA8 \uC62C\uB9B4 \uB54C\uB9C8\uB2E4 1\uAC1C\uC529
    \uC99D\uAC00\uD569\uB2C8\uB2E4.\n\n\uD018\uC2A4\uD2B8 \uAE30\uAC04\uC740 \uAE30\uBCF8\uC801\uC73C\uB85C
    1\uC77C\uC5D0\uC11C \uC2DC\uC791\uD558\uC5EC 1\uB808\uBCA8 \uC62C\uB9B4 \uB54C\uB9C8\uB2E4
    \uAC15\uD654 \uD6C4 \uB808\uBCA8\uC744 \uAE30\uC900\uC73C\uB85C 1~10\uB808\uBCA8\uC740
    1\uC529, 11~20\uB808\uBCA8\uC740 2\uC529, 21\uB808\uBCA8\uBD80\uD130\uB294 3\uC529
    \uC99D\uAC00\uD569\uB2C8\uB2E4. (\uC608: 9\uB808\uBCA8\uC740 9\uC77C, 10\uB808\uBCA8\uC740
    10\uC77C, 11\uB808\uBCA8\uC740 12\uC77C, 12\uB808\uBCA8\uC740 14\uC77C...) \uD018\uC2A4\uD2B8
    \uAE30\uAC04 \uAC15\uD654\uB294 \uC0C8\uB85C \uBC1B\uC740 \uD018\uC2A4\uD2B8\uBD80\uD130
    \uC801\uC6A9\uB418\uBA70, \uC774\uBBF8 \uBC1B\uC740 \uD018\uC2A4\uD2B8\uC758
    \uAE30\uAC04\uC774 \uB298\uC5B4\uB098\uC9C0\uB294 \uC54A\uC2B5\uB2C8\uB2E4."
  - "\uACF5\uBD80 \uD6A8\uC728, \uC218\uC785\uC740 1\uB808\uBCA8\uC5D0\uC11C 2\uB808\uBCA8\uB85C
    \uAC15\uD654\uD560 \uB54C 30 XP\uAC00 \uD544\uC694\uD558\uBA70, \uD55C \uBC88
    \uAC15\uD654\uD560 \uB54C\uB9C8\uB2E4 \uD544\uC694\uD55C XP\uAC00 7% \uC99D\uAC00\uD569\uB2C8\uB2E4.\n\n\uD018\uC2A4\uD2B8
    \uCD5C\uB300 \uAC1C\uC218\uB294 1\uB808\uBCA8\uC5D0\uC11C 2\uB808\uBCA8\uB85C
    \uAC15\uD654\uD560 \uB54C 1000 XP\uAC00 \uD544\uC694\uD558\uBA70, \uD55C \uBC88
    \uAC15\uD654\uD560 \uB54C\uB9C8\uB2E4 \uD544\uC694\uD55C XP\uAC00 50% \uC99D\uAC00\uD569\uB2C8\uB2E4.\n\n\uD018\uC2A4\uD2B8
    \uAE30\uAC04\uC740 1\uB808\uBCA8\uC5D0\uC11C 2\uB808\uBCA8\uB85C \uAC15\uD654\uD560
    \uB54C 1000 XP\uAC00 \uD544\uC694\uD558\uBA70, \uD55C \uBC88 \uAC15\uD654\uD560
    \uB54C\uB9C8\uB2E4 \uD544\uC694\uD55C XP\uAC00 20% \uC99D\uAC00\uD569\uB2C8\uB2E4.\n\n\uD544\uC694\uD55C
    XP\uB97C \uACC4\uC0B0\uD560 \uB54C \uC18C\uC218\uC810\uC740 \uBC84\uB9BD\uB2C8\uB2E4."
  - "\uAC15\uD654\uB97C \uD558\uB824\uBA74 \uBA3C\uC800 \uC0AC\uC6A9\uD560 XP(= \uAE30\uD638
    \uC67C\uCABD\uC5D0) \uB610\uB294 \uD655\uB960(= \uAE30\uD638 \uC624\uB978\uCABD\uC5D0)\uC744
    \uC785\uB825\uD574\uC57C \uD569\uB2C8\uB2E4. \uD55C\uCABD\uC744 \uBC14\uAFB8\uBA74
    \uB2E4\uB978 \uD55C\uCABD\uB3C4 \uAC19\uC774 \uBC14\uB00C\uBA70, \uC131\uACF5
    \uD655\uB960\uC740 \uC0AC\uC6A9\uD55C \uACBD\uD5D8\uCE58 \xF7 \uD544\uC694\uD55C
    \uACBD\uD5D8\uCE58 \xD7 100(%)\uB85C \uACC4\uC0B0\uB429\uB2C8\uB2E4.\n\n\uC608\uB97C
    \uB4E4\uC5B4 \uACF5\uBD80 \uD6A8\uC728\uC744 \uB808\uBCA8 10\uC5D0\uC11C 11\uB85C
    \uC5C5\uADF8\uB808\uC774\uB4DC\uD558\uB824\uBA74 30 \xD7 1.07<sup>9</sup> = 55
    XP\uAC00 \uD544\uC694\uD569\uB2C8\uB2E4.\n\n\uC774\uB54C XP \uB780\uC5D0 \"30\"\uC744
    \uC785\uB825\uD558\uBA74 30 \xF7 55 \xD7 100(%) = 54.5454(%)\uAC00 \uB429\uB2C8\uB2E4.
    \uB9C8\uCC2C\uAC00\uC9C0\uB85C 55\uB97C \uC785\uB825\uD558\uBA74 100%\uAC00 \uB429\uB2C8\uB2E4.
    \uC774\uB54C, 55)\uD544\uC694\uD55C XP)\uB97C \uCD08\uACFC\uD55C \uAC12\uC744
    \uC785\uB825\uD560 \uACBD\uC6B0 55\uB85C \uC790\uB3D9\uC73C\uB85C \uBC14\uB01D\uB2C8\uB2E4.
    \uC785\uB825\uD55C XP\uAC00 0\uC774\uAC70\uB098 \uBE48 \uC0C1\uD0DC\uC5D0\uC11C\uB294
    \uD655\uC778 \uBC84\uD2BC\uC774 \uB20C\uB9AC\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
  - "\uAC15\uD654\uB97C \uC131\uACF5\uD558\uBA74 \uB808\uBCA8\uC774 1 \uC99D\uAC00\uD558\uBA70,
    \uC2E4\uD328\uD558\uBA74 \uB808\uBCA8\uC774 1 \uAC10\uC18C\uD569\uB2C8\uB2E4.
    \uAC10\uC18C\uD560 \uB54C \uB808\uBCA8 1 \uBC11\uC73C\uB85C\uB294 \uAC10\uC18C\uD558\uC9C0
    \uC54A\uC73C\uBA70, \uB808\uBCA8 1\uC5D0\uC11C \uC2E4\uD328\uD558\uBA74 \uB808\uBCA8
    1\uC774 \uADF8\uB300\uB85C \uC720\uC9C0\uB418\uACE0 \uC904\uC5B4\uB4E4\uC9C0
    \uC54A\uC2B5\uB2C8\uB2E4.\n\n\uAC15\uD654\uC758 \uCD5C\uB300 \uB808\uBCA8\uC740
    \uC5C6\uC2B5\uB2C8\uB2E4."
