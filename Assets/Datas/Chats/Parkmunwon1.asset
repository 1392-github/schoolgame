    next: 0
    chatEvent: -1
    option: []
    disableNext: 0
  - value: "\uADF8 \uB2E4\uC74C\uC5D0 \uD559\uAD50\uC5D0 \uB300\uD574 \uC124\uBA85\uD574\uC904\uAED8!"
