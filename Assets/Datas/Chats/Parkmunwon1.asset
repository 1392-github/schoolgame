    next: 0
    chatEvent: -1
    option: []
    disableNext: 0
  - value: "\uC9D1 \uBC16\uC5D0\uC11C\uB9CC \uC4F8 \uC218 \uC788\uB294 \uD0A4\uB4E4\uC740\nW,
